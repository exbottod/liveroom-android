rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar admin panel. Dokumen admins/{uid} dibuat manual lewat Firebase Console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Data publik yang dibaca aplikasi (SVIP, dompet, dan sejenisnya).
    // Semua orang boleh membaca, hanya admin yang boleh menulis.
    match /pub/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daftar admin hanya bisa dibaca oleh pemiliknya sendiri, tidak bisa ditulis dari klien.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Selain itu tertutup.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
